from types import TracebackType
from typing import Self, Sequence

import numpy as np
import numpy.typing as npt

__version__: str

class EngineError(RuntimeError):
    code: str
    rank: int | None
    run_id: str
    operation: str
    sequence: int | None
    peer: int | None
    peer_endpoint: str

class Endpoint:
    def __init__(self, host: str, port: int) -> None: ...
    @property
    def host(self) -> str: ...
    @property
    def port(self) -> int: ...

class RunConfig:
    def __init__(
        self, *, rank: int, world_size: int, run_id: str, context_fingerprint: str,
        endpoints: Sequence[Endpoint], listen_address: str = "0.0.0.0",
        startup_timeout_ms: int = 30000, collective_timeout_ms: int = 30000,
        max_payload_bytes: int = 268435456,
    ) -> None: ...
    @property
    def rank(self) -> int: ...
    @property
    def world_size(self) -> int: ...
    @property
    def run_id(self) -> str: ...
    @property
    def context_fingerprint(self) -> str: ...
    @property
    def endpoints(self) -> list[Endpoint]: ...
    @property
    def listen_address(self) -> str: ...
    @property
    def startup_timeout_ms(self) -> int: ...
    @property
    def collective_timeout_ms(self) -> int: ...
    @property
    def max_payload_bytes(self) -> int: ...

class Communicator:
    def __init__(self, config: RunConfig) -> None: ...
    def all_reduce_sum(self, array: npt.NDArray[np.float32]) -> None: ...
    def close(self) -> None: ...
    @property
    def state(self) -> str: ...
    @property
    def next_sequence(self) -> int: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self, exception_type: type[BaseException] | None,
        exception: BaseException | None, traceback: TracebackType | None,
    ) -> None: ...
